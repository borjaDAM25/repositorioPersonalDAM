package modelo;

public class Medico {

	//ATRIBUTOS
	private int numColeg;
	private String nomApe;
	private int edad;
	private String espec;
	private int exp;
	private String centro;
	private boolean activo;
	
	
	//METODOS
	public Medico(int numColeg, String nomApe, int edad, String espec, int exp, String centro, boolean activo) {
		this.numColeg = numColeg;
		this.nomApe = nomApe;
		this.edad = edad;
		this.espec = espec;
		this.exp = exp;
		this.centro = centro;
		this.activo = activo;
	}
	public Medico() {
		numColeg = 0;
		nomApe = "Vacio";
		edad = 0;
		espec = "Vacio";
		exp = 0;
		centro = "Vacio";
		
	}

	private int getNumColeg() {
		return numColeg;
	}
	private void setNumColeg(int numColeg) {
		this.numColeg = numColeg;
	}
	private String getNomApe() {
		return nomApe;
	}
	private void setNomApe(String nomApe) {
		this.nomApe = nomApe;
	}
	private int getEdad() {
		return edad;
	}
	private void setEdad(int edad) {
		this.edad = edad;
	}
	private String getEspec() {
		return espec;
	}
	private void setEspec(String espec) {
		this.espec = espec;
	}
	private int getExp() {
		return exp;
	}
	private void setExp(int exp) {
		this.exp = exp;
	}
	private String getCentro() {
		return centro;
	}
	private void setCentro(String centro) {
		this.centro = centro;
	}
	private boolean isActivo() {
		return activo;
	}
	private void setActivo(boolean activo) {
		this.activo = activo;
	}	
	
	
	public sueldo(double sueldo) {
		if (espec.equalsIgnoreCase("neurocirujano") || espec.equalsIgnoreCase("investigador")) {
			sueldo=1600 +(50*exp) + 200;
		}else
		sueldo=1600 + (50*exp);
		
	}
	
	
	
	
	
	
}
